# EC2 / docker-compose environment. Copy to .env, then: chmod 600 .env
LIVE=false
BANKROLL=200
MAX_BET=20

POLYGON_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=

LEDGER_PATH=/data/ledger.db
MODEL_PATH=/data/model.joblib
LOG_LEVEL=INFO

SCAN_INTERVAL_SECONDS=60
MAX_MARKETS_PER_CYCLE=40
SIGNAL_COOLDOWN_SECONDS=3600
MIN_EV=0.02

MAX_DAILY_LOSS_PCT=0.20
MAX_DRAWDOWN_PCT=0.40
MAX_EXPOSURE_PCT=0.30

# Read-only dashboard served by the bot on the container's port 8099, published
# to 127.0.0.1:8099 on the host. Generate the token with: openssl rand -hex 32
WEB_ENABLED=true
SERVE_DASHBOARD=true
API_PORT=8099
DASHBOARD_TOKEN=
ALLOWED_ORIGIN=
