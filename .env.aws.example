# Copy to `.env` on the EC2 host: cp .env.aws.example .env
# NEVER commit the real .env. Never paste the private key into chat or logs.

# Master switch. Keep false until you have run DRY-RUN for at least a week.
LIVE=false

BANKROLL=200
MAX_BET=20
MAX_DAILY_LOSS_PCT=0.20
MAX_DRAWDOWN_PCT=0.40
MAX_EXPOSURE_PCT=0.30
MIN_EV=0.02

# Required only when LIVE=true.
POLYGON_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=

# Paths inside the container. The compose file pins these to the volume.
LEDGER_PATH=/data/ledger.db
MODEL_PATH=/data/model.joblib
LOG_LEVEL=INFO

SCAN_INTERVAL_SECONDS=60
MAX_MARKETS_PER_CYCLE=40
SIGNAL_COOLDOWN_SECONDS=3600
BOOK_STALENESS_SECONDS=20
CANCEL_ON_SHUTDOWN=true

# Used by the read-only status API. Set a long random value, e.g.
#   openssl rand -hex 32
DASHBOARD_TOKEN=
