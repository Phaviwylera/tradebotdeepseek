# Copy to .env for local use: cp .env.example .env
# NEVER commit the real file. Every value here is optional except LIVE.

# --- safety ---------------------------------------------------------------
# false = DRY-RUN: no authenticated CLOB request, no order, no private key.
LIVE=false
BANKROLL=200
MAX_BET=20

# --- credentials (LIVE only) ---------------------------------------------
POLYGON_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=

# --- storage --------------------------------------------------------------
LEDGER_PATH=ledger.db
MODEL_PATH=model.joblib
# Optional: download the artifact at startup (release asset, raw file, static host).
# This is how a host with no persistent disk gets a model.
MODEL_URL=
# Optional: append pre-resolution feature snapshots for training data.
# Off when empty. Needs a real disk, not the free ephemeral tier.
SNAPSHOT_PATH=
LOG_LEVEL=INFO

# --- pipeline -------------------------------------------------------------
SCAN_INTERVAL_SECONDS=60
MAX_MARKETS_PER_CYCLE=40
SIGNAL_COOLDOWN_SECONDS=3600
# Minimum edge/return. Also caps the snipe band at hold / (1 + MIN_EV).
MIN_EV=0.02
# Snipe price band. Strict: 0.93 -> [0.9300, 0.9314). Wider: 0.90 -> [0.9000, 0.9406).
# Widening does not create edge; it lowers the bar for the same 0.95 hold assumption.
SNIPE_MIN_ASK=0.93
SNIPE_MAX_ASK=0.97
SNIPE_HOLD_PROBABILITY=0.95
SNIPE_MAX_TTL_HOURS=2.4
ARB_THRESHOLD=0.985
# Discovery: reserve per-cycle book-fetch slots for markets closing soon.
# 0 restores volume-only selection, which makes SNIPE unreachable in practice.
NEAR_RESOLUTION_SLOTS=8
NEAR_RESOLUTION_WINDOW_HOURS=6
NEAR_RESOLUTION_OVERDUE_HOURS=24
# Allow sniping a market that is past its scheduled close (in-play sports).
SNIPE_OVERDUE_HOURS=24

# --- risk limits ----------------------------------------------------------
MAX_DAILY_LOSS_PCT=0.20
MAX_DRAWDOWN_PCT=0.40
MAX_EXPOSURE_PCT=0.30

# --- dashboard / status API ----------------------------------------------
# Local default: 127.0.0.1:8099. A platform PORT (Render) switches the bind to
# 0.0.0.0 automatically. Set API_PORT to pin a port explicitly.
WEB_ENABLED=true
SERVE_DASHBOARD=true
API_PORT=8099
# Bearer token for the read-only API. Generate: openssl rand -hex 32
DASHBOARD_TOKEN=
# Only needed if the dashboard is served from a different origin.
ALLOWED_ORIGIN=
